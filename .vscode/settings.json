{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/*.xmpdata": true,
        "**/*.lof": true,
        "**/*.lot": true,
        "**/*.fls": true,
        "**/*.out": true,
        "**/*.toc": true,
        "**/*.fmt": true,
        "**/latexmkrc": true,
        "**/*.xmpi": true,
        "**/*.synctex.gz": true,
        "**/*.fdb_latexmk": true,
        "**/*.auxlock": true,
        "**/*.bbl": true,
        "**/*.blg": true,
        "**/*.run.xml": true,
        "**/*.bcf": true,
        "**/*.log": true,
        "**/*.nav": true,
        "**/*.snm": true,
        "**/*.vrb": true,
        "**/*.aux": true,
        "**/*.synctex(busy)": true,
        "**/*.xdv": true,
        "**/*.brf": true,
        "**/cvpr.sty": true,
        "**/ieeenat_fullname.bst": true,
        "**/__pycache__": true,
        "**/.venv/": true,
        "**/.ruff_cache": true,
    },
    "cSpell.words": [
        "axhline",
        "axvline",
        "blit",
        "cmap",
        "cudnn",
        "ddof",
        "figsize",
        "fnmr",
        "fontsize",
        "imread",
        "imshow",
        "iresnet",
        "jshtml",
        "kdeplot",
        "keepdim",
        "linestyle",
        "mcolors",
        "mpimg",
        "nanargmin",
        "natsorted",
        "randn",
        "steelblue",
        "suptitle",
        "xlabel",
        "ylabel"
    ],
    "python.envFile": "${workspaceFolder}/.venv/bin/activate",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
}